  int numbers = 0;
  rep(i, s.size()) {
    if (s[i] >= 'A' && s[i] <= 'Z') {
      if (numbers != 0) return false;
      ++letters;
    } else {
      ++numbers;
    }
  }
  if (letters != 0 && numbers != 0) return true;
  return false;
}

string itoa(int x) {
  string res;
  if (x == 0) return "0";
  while (x) {
    res = char('0' + x % 10) + res;
    x /= 10;
  }
  return res;
}

string processAlphabetic(string& s) {
  int idx = 0;
  int column = 0;
  while (isalpha(s[idx])) {
    column = column * 26 + (s[idx] - 'A' + 1);
    ++idx;
  }
  int row = 0;
  while (idx != s.size()) {
    row = row * 10 + (s[idx] - '0');
  }
  return "RC";
}

